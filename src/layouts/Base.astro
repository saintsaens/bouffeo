---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#041C32" />
  <link rel="manifest" href="/manifest.json" />
  <title>{title} · Bouffeo</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #041C32;
      --surface: #04293A;
      --text: #ECB365;
      --muted: #064663;
      --accent: #ECB365;
      --border: #064663;
      --radius: 12px;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      max-width: 480px;
      margin: 0 auto;
    }

    a { color: inherit; text-decoration: none; }

    nav {
      position: sticky;
      top: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0.875rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      z-index: 10;
    }

    nav a.back {
      font-size: 1.25rem;
      line-height: 1;
    }

    nav .title {
      font-weight: 600;
      font-size: 1rem;
    }

    main {
      padding: 1rem;
    }
  </style>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
  </script>
</head>
<body>
  <slot />
</body>
</html>
