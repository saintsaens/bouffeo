---
import Base from '../../layouts/Base.astro';
import recipes from '../../data/recipes.json';

export function getStaticPaths() {
  return recipes.map(r => ({ params: { slug: r.slug }, props: { recipe: r } }));
}

const { recipe } = Astro.props;
---
<Base title={recipe.title}>
  <nav>
    <a href="/" class="back">←</a>
    <span class="title">{recipe.title}</span>
  </nav>
  <main>
    <p class="meta">{recipe.duration} · {recipe.servings} serving{recipe.servings > 1 ? 's' : ''}</p>

    <section class="block">
      <h2>Ingredients</h2>
      <ul class="ingredients">
        {recipe.ingredients.map(ing => (
          <li>
            <span class="amount">{ing.amount}</span>
            <span class="name">{ing.name}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2>Steps</h2>
      <ol class="steps">
        {recipe.steps.map(step => (
          <li>
            <p>{step}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>

<style>
  .meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .block h2 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  /* Ingredients */
  .ingredients {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ingredients li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .amount {
    font-size: 0.85rem;
    color: var(--muted);
    min-width: 70px;
  }

  .name {
    font-size: 1rem;
  }

  /* Steps */
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    background: #fff3ee;
    border-radius: 50%;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .steps li p {
    font-size: 0.95rem;
    line-height: 1.5;
    padding-top: 0.2rem;
  }
</style>
