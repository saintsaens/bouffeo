---
import Base from '../layouts/Base.astro';
import recipes from '../data/recipes.json';
---
<Base title="Recipes">
  <nav>
    <span class="title">🍳 Bouffeo</span>
  </nav>
  <main>
    <ul class="list">
      {recipes.map(r => (
        <li>
          <a href={`/recipes/${r.slug}`} class="card">
            <div class="card-body">
              <h2>{r.title}</h2>
              <p class="meta">{r.duration} · {r.servings} serving{r.servings > 1 ? 's' : ''}</p>
              <p class="tags">{r.tags.map(t => `#${t}`).join(' ')}</p>
            </div>
            <span class="arrow">›</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }

  .card-body { flex: 1; }

  .card h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .tags {
    font-size: 0.8rem;
    color: var(--accent);
  }

  .arrow {
    font-size: 1.5rem;
    color: var(--muted);
  }
</style>
