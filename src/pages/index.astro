---
import Base from '../layouts/Base.astro';
import recipes from '../data/recipes.json';
---
<Base title="Recipes">
  <main>
    <div id="grid" class="grid"></div>
    <div class="bottom">
      <button id="ingredients-btn">Voir les ingrédients</button>
      <div class="selector">
        <button id="prev" aria-label="fewer">⬅</button>
        <span id="count">1</span>
        <button id="next" aria-label="more">➡</button>
      </div>
    </div>

    <div id="sheet-backdrop" class="sheet-backdrop" hidden></div>
    <div id="sheet" class="sheet" hidden aria-modal="true" role="dialog">
      <div class="sheet-header">
        <span class="sheet-title">Ingrédients</span>
        <button id="sheet-close" aria-label="Fermer">✕</button>
      </div>
      <ul id="sheet-list" class="sheet-list"></ul>
    </div>
  </main>
</Base>

<script define:vars={{ recipes }}>
  const gridEl = document.getElementById('grid');
  const countEl = document.getElementById('count');
  let count = 1;
  let picked = [];

  function pickOne(exclude) {
    const pool = recipes.filter(r => !exclude.includes(r.slug));
    if (!pool.length) return recipes[Math.floor(Math.random() * recipes.length)];
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function makeTile(r, index) {
    const div = document.createElement('div');
    div.className = 'tile';

    const body = document.createElement('button');
    body.className = 'tile-body';
    body.textContent = r.title;
    body.addEventListener('click', () => rerollOne(index));

    const link = document.createElement('a');
    link.className = 'tile-open';
    link.href = `/recipes/${r.slug}`;
    link.textContent = '›';

    div.appendChild(body);
    div.appendChild(link);
    return div;
  }

  function rerollOne(index) {
    const r = pickOne(picked.map(p => p.slug));
    picked[index] = r;
    const tiles = gridEl.querySelectorAll('.tile');
    const tile = tiles[index];
    tile.querySelector('.tile-body').textContent = r.title;
    tile.querySelector('.tile-open').href = `/recipes/${r.slug}`;
  }

  function setGrid() {
    gridEl.style.gridTemplateColumns = '1fr 1fr';
    countEl.textContent = count;
  }

  function reroll() {
    picked = [];
    for (let i = 0; i < count; i++) {
      const r = pickOne(picked.map(p => p.slug));
      picked.push(r);
    }
    gridEl.innerHTML = '';
    picked.forEach((r, i) => gridEl.appendChild(makeTile(r, i)));
    setGrid();
  }

  function setCount(n) {
    const prev = count;
    count = n;
    if (count > prev) {
      for (let i = prev; i < count; i++) {
        const r = pickOne(picked.map(p => p.slug));
        picked.push(r);
        gridEl.appendChild(makeTile(r, picked.length - 1));
      }
    } else {
      for (let i = prev; i > count; i--) {
        picked.pop();
        gridEl.removeChild(gridEl.lastChild);
      }
    }
    setGrid();
  }

  document.getElementById('prev').addEventListener('click', () => { if (count > 1) setCount(count - 1); });
  document.getElementById('next').addEventListener('click', () => { if (count < 4) setCount(count + 1); });

  const sheet = document.getElementById('sheet');
  const backdrop = document.getElementById('sheet-backdrop');
  const sheetList = document.getElementById('sheet-list');

  function openSheet() {
    const totals = new Map();
    for (const recipe of picked) {
      for (const ing of recipe.ingredients) {
        const key = ing.name.toLowerCase();
        const qty = parseFloat(ing.amount) || 0;
        if (totals.has(key)) {
          totals.get(key).amount += qty;
        } else {
          totals.set(key, { name: ing.name, amount: qty });
        }
      }
    }

    sheetList.innerHTML = '';
    for (const { name, amount } of totals.values()) {
      const li = document.createElement('li');
      const amountStr = Number.isInteger(amount) ? String(amount) : amount.toFixed(1).replace(/\.0$/, '');
      const copyText = `${amountStr} ${name}`;
      li.innerHTML = `<span class="s-amount">${amountStr}</span><span class="s-name">${name}</span><span class="s-copied" aria-hidden="true">✓</span>`;
      li.title = 'Copier';
      li.addEventListener('click', () => {
        navigator.clipboard.writeText(copyText).then(() => {
          li.classList.add('copied');
          setTimeout(() => li.classList.remove('copied'), 1500);
        });
      });
      sheetList.appendChild(li);
    }

    sheet.hidden = false;
    backdrop.hidden = false;
    requestAnimationFrame(() => {
      sheet.classList.add('open');
      backdrop.classList.add('open');
    });
  }

  function closeSheet() {
    sheet.classList.remove('open');
    backdrop.classList.remove('open');
    sheet.addEventListener('transitionend', () => {
      sheet.hidden = true;
      backdrop.hidden = true;
    }, { once: true });
  }

  document.getElementById('ingredients-btn').addEventListener('click', openSheet);
  document.getElementById('sheet-close').addEventListener('click', closeSheet);
  backdrop.addEventListener('click', closeSheet);

  reroll();
</script>

<style>
  main {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    padding-bottom: 5rem;
    gap: 1.5rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  :global(.tile) {
    display: flex;
    height: calc(100svh / 3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  :global(.tile-body) {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
    color: var(--accent);
    background: none;
    border: none;
    cursor: pointer;
  }

  :global(.tile-open) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    font-size: 1.5rem;
    color: var(--muted);
    text-decoration: none;
    border-left: 1px solid var(--border);
    flex-shrink: 0;
  }

  :global(.tile-open:active),
  :global(.tile-body:active) {
    background: var(--muted);
  }

  .bottom {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #ingredients-btn {
    width: 100%;
    padding: 1rem;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  #ingredients-btn:active { opacity: 0.85; }

  .selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .selector button {
    flex: 1;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 1.25rem;
    cursor: pointer;
  }

  .selector button:active { background: var(--muted); }

  #count {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    min-width: 2ch;
    text-align: center;
  }

  .sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.25s;
    z-index: 20;
  }

  .sheet-backdrop.open { opacity: 1; }

  .sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    max-width: 480px;
    margin: 0 auto;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-radius: var(--radius) var(--radius) 0 0;
    padding: 1.25rem 1.5rem 2.5rem;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 30;
    max-height: 80svh;
    overflow-y: auto;
  }

  .sheet.open { transform: translateY(0); }

  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .sheet-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  #sheet-close {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.25rem;
  }

  .sheet-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sheet-list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0.25rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .sheet-list li:active { background: var(--muted); }

  .s-amount {
    font-size: 0.85rem;
    color: var(--muted);
    min-width: 50px;
  }

  .s-name {
    font-size: 1rem;
    color: var(--text);
    flex: 1;
  }

  .s-copied {
    font-size: 0.85rem;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .sheet-list li.copied .s-copied { opacity: 1; }
</style>
