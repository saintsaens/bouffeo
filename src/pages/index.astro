---
import Base from '../layouts/Base.astro';
import recipes from '../data/recipes.json';
---
<Base title="Recipes">
  <main>
    <div id="grid" class="grid"></div>
    <div class="bottom">
      <button id="reroll">Reroll</button>
      <div class="selector">
        <button id="prev" aria-label="fewer">⬅</button>
        <span id="count">1</span>
        <button id="next" aria-label="more">➡</button>
      </div>
    </div>
  </main>
</Base>

<script define:vars={{ recipes }}>
  const gridEl = document.getElementById('grid');
  const countEl = document.getElementById('count');
  let count = 1;
  let picked = [];

  function pickOne(exclude) {
    const pool = recipes.filter(r => !exclude.includes(r.slug));
    if (!pool.length) return recipes[Math.floor(Math.random() * recipes.length)];
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function makeTile(r) {
    const a = document.createElement('a');
    a.className = 'tile';
    a.href = `/recipes/${r.slug}`;
    a.textContent = r.title;
    return a;
  }

  function setGrid() {
    gridEl.style.gridTemplateColumns = count === 1 ? '1fr' : '1fr 1fr';
    countEl.textContent = count;
  }

  function reroll() {
    picked = [];
    for (let i = 0; i < count; i++) {
      const r = pickOne(picked.map(p => p.slug));
      picked.push(r);
    }
    gridEl.innerHTML = '';
    picked.forEach(r => gridEl.appendChild(makeTile(r)));
    setGrid();
  }

  function setCount(n) {
    const prev = count;
    count = n;
    if (count > prev) {
      for (let i = prev; i < count; i++) {
        const r = pickOne(picked.map(p => p.slug));
        picked.push(r);
        gridEl.appendChild(makeTile(r));
      }
    } else {
      for (let i = prev; i > count; i--) {
        picked.pop();
        gridEl.removeChild(gridEl.lastChild);
      }
    }
    setGrid();
  }

  document.getElementById('reroll').addEventListener('click', reroll);
  document.getElementById('prev').addEventListener('click', () => { if (count > 1) setCount(count - 1); });
  document.getElementById('next').addEventListener('click', () => { if (count < 4) setCount(count + 1); });

  reroll();
</script>

<style>
  main {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding: 1.5rem;
    gap: 1.5rem;
    box-sizing: border-box;
  }

  .grid {
    flex: 1;
    display: grid;
    gap: 1rem;
    min-height: 0;
  }

  :global(.tile) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--accent);
    min-height: 0;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-shrink: 0;
  }

  button {
    padding: 0.75rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  button:active { background: var(--muted); }

  #reroll { flex: 1; }

  .selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #count {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    min-width: 1ch;
    text-align: center;
  }
</style>
